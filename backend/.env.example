# Métricas LikeHome — copie este arquivo como .env e ajuste os valores.
NODE_ENV=production
PORT=3003

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRES_IN=8h

DB_PATH=/opt/metricas-likehome/backend/data/database.sqlite

# Aceita uma ou mais origens separadas por vírgula.
ALLOWED_ORIGIN=https://metricaslike.g3tsistemas.com.br
